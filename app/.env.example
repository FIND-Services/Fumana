# Fumana configuration. Copy to `.env` and fill in. Never commit `.env`.
#
# Two runtime postures, chosen entirely by env:
#
#   * Supabase unset  -> the app runs exactly as the prototype did: in-memory
#     state, facade auth, and the LLM/TTS calls hit the Vite dev middleware
#     (POST /api/claude, POST /api/tts). Demo mode works with no keys at all.
#   * Supabase set    -> real persistence and auth via Supabase, and the
#     LLM/TTS calls hit the deployed Supabase Edge Functions instead.
#
# The VITE_-prefixed vars below ship in the browser bundle. The Supabase anon
# key is safe to expose by design; row-level security on the database is what
# guards the data. All PROVIDER keys stay non-VITE_ and server-side only.

# ---------------------------------------------------------------------------
# Supabase (optional). Set both to switch the app into backend mode.
# Project URL + anon key: Supabase dashboard -> Project Settings -> API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Server-side secrets (read by the Vite middleware OR set as Edge Function
# secrets). NOT prefixed with VITE_, so Vite never bundles them.

# Demo mode. When true, the LLM endpoint returns realistic pre-built responses
# and no provider is called, so the whole app is live with no API key.
DEMO_MODE=false

# Language model (provider-agnostic). Switching providers is just these lines.
#   LLM_PROVIDER: anthropic | openai
# Leave unset and the LLM endpoint returns 501, keeping scoring, the copilots,
# and the Experience Alchemist inert (the app shows a clear waiting state).
LLM_PROVIDER=
LLM_API_KEY=
# Optional model override (else a per-provider default):
#   anthropic -> claude-sonnet-4-6
#   openai    -> gpt-4o-mini
LLM_MODEL=

# Text-to-speech (ElevenLabs). Without a key the TTS endpoint returns 501 and
# the browser falls back to SpeechSynthesis, so the interview is never silent.
ELEVENLABS_API_KEY=
# Voice id (default is ElevenLabs' "Rachel"). Pick a warm, calm, African-English
# voice in your ElevenLabs library to match Zuri's voice charter.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
